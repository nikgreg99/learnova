# ==========================================
# Application
# ==========================================

APP_NAME=learnova-backend
APP_PORT=8080
# ==========================================
# Learnova PostgreSQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnova
DB_USER=learnova-admin
DB_PASSWORD=CHANGE_E

# ==========================================
# PostgreSQL Docker Image
# ==========================================
POSTGRES_IMAGE_NAME=postgres
POSTGRES_IMAGE_VERSION=18

# ==========================================
# Keycloak Docker Image
# ==========================================

KEYCLOAK_IMAGE_NAME=quay.io/keycloak/keycloak
KEYCLOAK_IMAGE_VERSION=26.4.7
KEYCLOAK_COMMAND='start-dev --import-realm'
# ==========================================
# Keycloak Admin
# ==========================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# ==========================================
# Keycloak Dedicated Database
# ==========================================

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ==========================================
# Keycloak HTTP
# ==========================================
KEYCLOAK_SCHEME=http
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8081
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_HTTP_ENABLED=true

# ==========================================
# JWT validation (local backend profile)
# ==========================================
KEYCLOAK_REALM=learnova
KEYCLOAK_ADMIN_CLIENT_ID=learnova-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SYNC_TEST_USERS=true

# ==========================================
# Mailpit Configuration (Mock SMTP Server)
# ==========================================
MAILPIT_IMAGE_NAME=axllent/mailpit
MAILPIT_IMAGE_VERSION=latest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_BIND_ADDRESS=127.0.0.1

# ==========================================
# RabbitMQ Configuration (Message Broker)
# ==========================================
RABBITMQ_IMAGE_NAME=rabbitmq
RABBITMQ_IMAGE_VERSION=4-management
RABBITMQ_USER=learnova
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=learnova
RABBITMQ_AMQP_BIND_ADDRESS=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_BIND_ADDRESS=127.0.0.1
RABBITMQ_UI_PORT=15672

# ==========================================
# Redis Docker Image and Rate Limiting
# ==========================================
REDIS_IMAGE_NAME=redis
REDIS_IMAGE_VERSION=7-alpine
REDIS_PORT=6379
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=100
RATE_LIMIT_PUBLIC_PER_MINUTE=10
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60

# ==========================================
# Backend Docker Images
# ==========================================
LEARNOVA_BACKEND_IMAGE_NAME=learnova-backend
LEARNOVA_BACKEND_IMAGE_VERSION=local
MAVEN_IMAGE_NAME=maven
MAVEN_IMAGE_VERSION=3.9-eclipse-temurin-21
JAVA_RUNTIME_IMAGE_NAME=eclipse-temurin
JAVA_RUNTIME_IMAGE_VERSION=21-jre
