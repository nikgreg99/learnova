# ==========================================
# Application
# ==========================================

APP_NAME=learnova-backend
APP_PORT=8080
JAVA_VERSION=21
# ==========================================
# Learnova PostgreSQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnova
DB_USER=learnova-admin
DB_PASSWORD=CHANGE_E

# ==========================================
# PostgreSQL Docker Image
# ==========================================
POSTGRES_IMAGE_NAME=postgres
POSTGRES_IMAGE_VERSION=18

# ==========================================
# Keycloak Docker Image
# ==========================================

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.7
KEYCLOAK_COMMAND='start-dev --import-realm'
# ==========================================
# Keycloak Admin
# ==========================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# ==========================================
# Keycloak Dedicated Database
# ==========================================

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ==========================================
# Keycloak HTTP
# ==========================================
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_HTTP_ENABLED=true

# ==========================================
# Spring Security / OAuth2
# ==========================================
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/learnova
# JWKS interno per il backend Docker
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/learnova/protocol/openid-connect/certs

KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=learnova
KEYCLOAK_ADMIN_CLIENT_ID=learnova-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME