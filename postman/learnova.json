                    "name": "Partially update lesson",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Dependency Injection\",\n  \"description\": \"Overview of inversion of control and dependency injection\",\n  \"content\": \"# Dependency Injection\\n\\nLesson content goes here.\",\n  \"position\": 2,\n  \"duration\": 25\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/courses/{{courseId}}/lessons/{{lessonId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "courses",
                                "{{courseId}}",
                                "lessons",
                                "{{lessonId}}"
                            ]
                        },
                        "description": "Updates only the supplied fields. Omitted or null fields are left unchanged according to the API implementation. If provided, position must be greater than zero and duration must be zero or greater. Requires course ownership or ADMIN privileges."
                    },
                    "response": []
                },
                {
                    "name": "Delete lesson",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/courses/{{courseId}}/lessons/{{lessonId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "courses",
                                "{{courseId}}",
                                "lessons",
                                "{{lessonId}}"
                            ]
                        },
                        "description": "Deletes the specified lesson. Requires course ownership or ADMIN privileges."
                    },
                    "response": []
                }
            ],
            "description": "Lesson management for a specific course.\n\nReading lessons requires authentication and an authorized role. Creating, updating, partially updating, and deleting lessons require ownership of the parent course or ADMIN privileges."
        }
