              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Elenca gli utenti a pagine di 20, dal più recente. Include account disabilitati ed eliminati."
          },
          "response": []
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Recupera il profilo dell'utente indicato, inclusi account disabilitati ed eliminati."
          },
          "response": []
        },
        {
          "name": "Update user profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{userUsername}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Aggiorna nome, cognome, email e username in Learnova e Keycloak. Richiede un JWT valido."
          },
          "response": []
        },
        {
          "name": "Update user status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISABLED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}/status",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users",
                "{{userId}}",
                "status"
              ]
            },
            "description": "Invia status ACTIVE per abilitare oppure DISABLED per disabilitare l'utente."
          },
          "response": []
        },
        {
          "name": "Soft delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Imposta lo stato DELETED senza eliminare fisicamente il record. Richiede un JWT valido."
          },
          "response": []
        }
      ],
      "description": "Registrazione e gestione degli utenti.\n\nEndpoint inclusi:\n- POST /api/{{version}}/users - crea un utente; endpoint pubblico, assegna STUDENT se roles è omesso.\n- GET /api/{{version}}/users?page=0&size=20 - elenca gli utenti paginati, inclusi account disabilitati ed eliminati.\n- GET /api/{{version}}/users/{{userId}} - recupera un utente per ID.\n- PUT /api/{{version}}/users/{{userId}} - aggiorna nome, cognome, email e username in Learnova e Keycloak.\n- PATCH /api/{{version}}/users/{{userId}}/status - abilita (status ACTIVE) o disabilita (status DISABLED) l'utente in Learnova e Keycloak.\n- DELETE /api/{{version}}/users/{{userId}} - imposta DELETED in Learnova e disabilita l'account Keycloak (soft delete).\n\nLe operazioni diverse dalla registrazione richiedono autenticazione."
    },
