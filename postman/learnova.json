                    "name": "Create lesson",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"{{lessonTitle}}\",\n  \"description\": \"{{lessonDescription}}\",\n  \"content\": \"{{lessonContent}}\",\n  \"position\": 1,\n  \"duration\": 15\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/courses/{{courseId}}/lessons",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "courses",
                                "{{courseId}}",
                                "lessons"
                            ]
                        },
                        "description": "Creates a lesson in the selected course. The position is 1-based and must be greater than or equal to 1. Duration is expressed in minutes and must be zero or greater. Requires course ownership or ADMIN privileges."
                    },
                    "response": []
                },
                {
                    "name": "Update lesson",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"{{lessonTitle}}\",\n  \"description\": \"{{lessonDescription}}\",\n  \"content\": \"{{lessonContent}}\",\n  \"position\": 1,\n  \"duration\": 20\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/courses/{{courseId}}/lessons/{{lessonId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "courses",
                                "{{courseId}}",
                                "lessons",
                                "{{lessonId}}"
                            ]
                        },
                        "description": "Replaces all lesson fields. Title is required; position must be at least 1; duration must be zero or greater. Requires course ownership or ADMIN privileges."
                    },
                    "response": []
                },
