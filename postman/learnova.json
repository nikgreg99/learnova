{
    "info": {
        "_postman_id": "551c3e61-a411-4a74-a566-b760d94d610a",
        "name": "Learnova LMS API",
        "description": "Learnova REST API collection. Protected requests inherit the collection-level OAuth 2.0 Authorization Code flow with PKCE (S256). Select Get New Access Token and then Use Token. Use a Keycloak test account with the role required by the request. Public registration assigns STUDENT automatically; privileged roles must only be assigned by an administrator.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_exporter_id": "12861475"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Get current user",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/auth/me",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Returns the profile associated with the authenticated Keycloak access token."
                    },
                    "response": []
                }
            ],
            "description": "Authentication and current-user information.\n\nProtected requests use the collection-level OAuth 2.0 Authorization Code flow with PKCE (S256). In Postman, select Get New Access Token and then Use Token. Choose the matching Keycloak test account in the browser login page before requesting a token."
        },
        {
            "name": "Users",
            "item": [
                {
                    "name": "Create user (public registration)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users"
                            ]
                        },
                        "description": "Creates a new Learnova account. This endpoint is public and must assign the STUDENT role server-side. The request intentionally does not accept a roles property."
                    },
                    "response": []
                },
                {
                    "name": "List users",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users?page=0&size=20",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "0"
                                },
                                {
                                    "key": "size",
                                    "value": "20"
                                }
                            ]
                        },
                        "description": "Returns a paginated list of users, including disabled and soft-deleted accounts. Requires an authenticated account with the appropriate administrative permissions."
                    },
                    "response": []
                },
                {
                    "name": "Get user by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users",
                                "{{userId}}"
                            ]
                        },
                        "description": "Returns the user identified by the supplied ID, including disabled or soft-deleted accounts."
                    },
                    "response": []
                },
                {
                    "name": "Update user profile",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{userUsername}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users",
                                "{{userId}}"
                            ]
                        },
                        "description": "Updates the user's first name, last name, email address, and username in Learnova and Keycloak."
                    },
                    "response": []
                },
                {
                    "name": "Update user status",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"DISABLED\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}/status",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users",
                                "{{userId}}",
                                "status"
                            ]
                        },
                        "description": "Changes the user's status. Use ACTIVE to enable the account or DISABLED to disable it."
                    },
                    "response": []
                },
                {
                    "name": "Soft delete user",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users/{{userId}}",
                            "protocol": "{{proto}}",
                            "host": [
                                "{{host}}"
                            ],
                            "port": "{{port}",
                            "path": [
                                "api",
                                "{{version}}",
                                "users",
                                "{{userId}}"
                            ]
                        },
                        "description": "Marks the user as DELETED without physically removing the database record and disables the corresponding Keycloak account."
                    },
                    "response": []
                }
            ],
            "description": "Public registration and user administration.\n\nPublic registration must assign STUDENT on the server side. Role assignment must be restricted to administrator-only functionality; do not expose privileged role selection on the public registration endpoint."
        },
        {
