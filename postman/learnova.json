            "description": "Course catalog and course management.\n\nReading courses requires authentication. Creating courses requires INSTRUCTOR or ADMIN privileges. Updating and deleting courses require course ownership or ADMIN privileges."
        },
        {
            "name": "Lessons",
            "item": [
                {
                    "name": "Get lessons",
                    "request": {
                        "method": "GET",
                        "header": [
