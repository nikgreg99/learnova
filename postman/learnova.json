  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/auth/me",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "auth",
                "me"
              ]
            },
            "description": "Restituisce il profilo associato al JWT di accesso ricevuto da Keycloak."
          },
          "response": []
        }
      ],
      "description": "Autenticazione e profilo utente.\n\nEndpoint inclusi:\n- GET /api/{{version}}/auth/me - restituisce il profilo associato al token Keycloak.\n\nRichiede autenticazione tramite la configurazione OAuth 2.0 della collection. Account di test locale: {{testAccountName}}."
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{proto}}://{{host}}:{{port}}/api/{{version}}/users",
              "protocol": "{{proto}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "{{version}}",
                "users"
              ]
            },
            "description": "Endpoint pubblico di registrazione. Omette roles così il servizio assegna il ruolo STUDENT predefinito."
          },
          "response": []
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
